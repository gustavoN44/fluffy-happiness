# Copy to .env and fill in:  cp .env.example .env
# Both docker-compose and the Python app read this file. It is gitignored.

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# --- Application config ---
# Connection string the app uses to reach Postgres. Must match the POSTGRES_* above.
# Correct as written when running the app on your host machine. Inside docker-compose
# the database is reachable as `db` instead, and compose overrides this automatically —
# so you do not need to change it to run the containerized stack.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- API keys (bring your own; both providers are paid) ---
# REQUIRED. Used for generation (gpt-4o-mini), for the text-embedding-3-small
# configurations, and as the judge model in the evaluation harness.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# REQUIRED to run the SERVED configuration. PRODUCTION uses voyage-4-large, the
# embedding model the Phase 5 experiment matrix selected, so the API will not answer
# without this. Only optional if you switch to an OpenAI-only config such as BASELINE.
#   https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-...

# --- Optional: host ports published by docker-compose ---
# Defaults shown; uncomment to change if something already occupies them.
# API_PORT=8000
# WEB_PORT=3000

# --- Optional: model overrides (all have working defaults) ---
# The PIPELINE's chunker and embedder do NOT come from here — they come from the
# RunConfig in app/pipeline.py, which is what makes the experiment matrix a
# config-only sweep. These settings cover the generation model and the embedding
# model the evaluation judge uses.
# GENERATION_MODEL=gpt-4o-mini
# GENERATION_TEMPERATURE=0.0
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
